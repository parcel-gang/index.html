<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Send Me a Topic</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            background: #f2f4f7;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            margin: 0;
        }

        .container {
            background: white;
            width: 90%;
            max-width: 500px;
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0 5px 25px rgba(0,0,0,0.1);
        }

        h1 {
            text-align: center;
        }

        input,
        textarea {
            width: 100%;
            box-sizing: border-box;
            padding: 12px;
            margin-top: 8px;
            margin-bottom: 18px;
            border: 1px solid #ccc;
            border-radius: 8px;
            font-size: 16px;
        }

        textarea {
            height: 150px;
            resize: vertical;
        }

        button {
            width: 100%;
            padding: 13px;
            border: none;
            border-radius: 8px;
            background: #0088cc;
            color: white;
            font-size: 17px;
            cursor: pointer;
        }

        button:hover {
            background: #0077b5;
        }

        #message {
            text-align: center;
            margin-top: 15px;
            font-weight: bold;
        }
    </style>
</head>

<body>

<div class="container">

    <h1>💬 Send Me a Topic</h1>

    <form id="topicForm">

        <label>Topic</label>

        <input
            type="text"
            id="topic"
            placeholder="Write your topic..."
            required
        >

        <label>Details</label>

        <textarea
            id="details"
            placeholder="Write the details..."
            required
        ></textarea>

        <button type="submit">
            🚀 Submit
        </button>

    </form>

    <div id="message"></div>

</div>


<script>

document.getElementById("topicForm").addEventListener("submit", async function(event) {

    event.preventDefault();

    const topic = document.getElementById("topic").value;
    const details = document.getElementById("details").value;

    const messageBox = document.getElementById("message");

    messageBox.textContent = "Sending...";

    try {

        const response = await fetch("/send-message", {

            method: "POST",

            headers: {
                "Content-Type": "application/json"
            },

            body: JSON.stringify({
                topic: topic,
                details: details
            })

        });

        const result = await response.json();

        if (result.success) {

            messageBox.textContent = "✅ Submitted successfully!";

            document.getElementById("topicForm").reset();

        } else {

            messageBox.textContent = "❌ Something went wrong.";

        }

    } catch (error) {

        messageBox.textContent = "❌ Server error.";

    }

});

</script>

</body>
</html>
